<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="GW2EIParserAvalonia.Views.UpdaterWindow"
    Width="420"
    Height="300"
    CanResize="False"
    Title="GW2 Elite Insights Updater"
    WindowStartupLocation="CenterOwner">

    <Grid
        Margin="28"
        RowDefinitions="Auto,Auto,Auto,*,Auto">

        <StackPanel
            Grid.Row="0"
            Spacing="5">

            <TextBlock
                Text="Update available"
                FontSize="22"
                FontWeight="SemiBold" />

            <TextBlock
                Text="A new version of Elite Insights is ready to download."
                Opacity="0.7" />

        </StackPanel>

        <Border
            Grid.Row="1"
            Margin="0,22,0,0"
            Padding="18"
            CornerRadius="8"
            Background="{DynamicResource ThemeControlLowBrush}">

            <Grid ColumnDefinitions="*,Auto,*">

                <StackPanel
                    Grid.Column="0"
                    Spacing="4">

                    <TextBlock
                        Text="CURRENT"
                        FontSize="11"
                        FontWeight="Bold"
                        Opacity="0.6" />

                    <TextBlock
                        x:Name="CurrentVersionText"
                        FontSize="18"
                        FontWeight="SemiBold" />

                </StackPanel>

                <TextBlock
                    Grid.Column="1"
                    Margin="16,8"
                    Text="→"
                    FontSize="20"
                    Opacity="0.5"
                    VerticalAlignment="Center" />

                <StackPanel
                    Grid.Column="2"
                    Spacing="4">

                    <TextBlock
                        Text="LATEST"
                        FontSize="11"
                        FontWeight="Bold"
                        Opacity="0.6" />

                    <TextBlock
                        x:Name="LatestVersionText"
                        FontSize="18"
                        FontWeight="SemiBold" />

                </StackPanel>

            </Grid>
        </Border>

        <TextBlock
            x:Name="DownloadSizeText"
            Grid.Row="2"
            Margin="2,14,0,0"
            Opacity="0.7" />

        <Border Grid.Row="3" />

        <Grid
            Grid.Row="4"
            Margin="0,20,0,0"
            ColumnDefinitions="Auto,*,Auto,Auto"
            ColumnSpacing="8">

            <Button
                Grid.Column="0"
                Content="Release Notes"
                Padding="14,8"
                Click="ReleaseNotesButton_Click" />

            <Border
                Grid.Column="1"
                Width="1"
                Margin="8,2"
                Background="#808080" />

            <Button
                Grid.Column="2"
                Content="Dismiss"
                Padding="14,8"
                Click="DismissButton_Click" />

            <Button
                Grid.Column="3"
                Content="Update"
                MinWidth="105"
                Padding="14,8"
                HorizontalContentAlignment="Center"
                Click="UpdateButton_Click" />

        </Grid>

    </Grid>
</Window>