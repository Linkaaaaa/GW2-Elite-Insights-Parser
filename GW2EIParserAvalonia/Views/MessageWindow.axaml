<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:GW2EIParserAvalonia.Views"
    x:Class="GW2EIParserAvalonia.Views.MessageWindow"
    x:DataType="views:MessageWindow"
    Width="320"
    Height="150"
    CanResize="False">

    <Grid
        Margin="20"
        RowDefinitions="*,Auto"
        RowSpacing="15">

        <TextBlock
            Text="{Binding Message}"
            TextWrapping="Wrap"
            VerticalAlignment="Center" />

        <Button
            Grid.Row="1"
            Content="OK"
            HorizontalAlignment="Right"
            Click="OkButton_Click" />

    </Grid>
</Window>