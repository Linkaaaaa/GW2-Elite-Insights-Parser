<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:GW2EIParserAvalonia.ViewModels"
    x:Class="GW2EIParserAvalonia.Views.MainWindow"
    x:DataType="viewModels:MainWindowViewModel"
    mc:Ignorable="d"
    Width="1100"
    Height="700"
    MinWidth="900"
    MinHeight="500"
    Title="GW2 Elite Insights Parser"
    DragDrop.AllowDrop="True"
    DragDrop.DragOver="MainWindow_DragOver"
    DragDrop.Drop="MainWindow_Drop">

    <Grid
        Margin="24"
        RowDefinitions="Auto,Auto,*,Auto,Auto"
        RowSpacing="16">

        <!-- Header -->
        <Grid
            Grid.Row="0"
            ColumnDefinitions="*,Auto"
            ColumnSpacing="20">

            <StackPanel Spacing="3">
                <TextBlock
                    Text="GW2 Elite Insights Parser"
                    FontSize="26"
                    FontWeight="SemiBold" />

                <TextBlock
                    Text="{Binding Status}"
                    FontSize="13"
                    Opacity="0.65" />
            </StackPanel>

            <TextBlock
                Grid.Column="1"
                Text="Drop logs anywhere in this window"
                FontSize="12"
                Opacity="0.55"
                VerticalAlignment="Center" />

        </Grid>

        <!-- Main toolbar -->
        <StackPanel
            Grid.Row="1"
            Orientation="Horizontal"
            Spacing="8"
            VerticalAlignment="Center">

            <Button
                Content="Add Files"
                Click="AddFilesButton_Click"
                MinWidth="110"
                Padding="16,9" />

            <Button
                Content="Populate from directory"
                Click="PopulateButton_Click"
                MinWidth="165"
                Padding="16,9" />

            <TextBlock
                Text="Time:"
                VerticalAlignment="Center"
                Margin="12,0,0,0"
                Opacity="0.7" />

            <NumericUpDown
                Value="{Binding PopulateHourLimit, Mode=TwoWay}"
                Minimum="0"
                Maximum="86400000"
                Width="150"
                HorizontalContentAlignment="Right"
                ToolTip.Tip="Files older than this many hours will be ignored. Set to 0 for no limit." />

            <TextBlock
                Text="hours"
                VerticalAlignment="Center"
                Opacity="0.6" />

        </StackPanel>

        <!-- Log table -->
        <Border
            Grid.Row="2"
            BorderThickness="1"
            CornerRadius="6"
            Padding="1">

            <DataGrid
                ItemsSource="{Binding LogFiles}"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                CanUserResizeColumns="True"
                GridLinesVisibility="Horizontal"
                RowHeight="40"
                HeadersVisibility="Column"
                DoubleTapped="LogFilesGrid_DoubleTapped">

                <DataGrid.Columns>

                    <!-- Remove row -->
                    <DataGridTemplateColumn
                        Header=""
                        Width="33">

                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button
                                    Content="X"
                                    Command="{Binding RemoveCommand}"
                                    Margin="3"
                                    HorizontalAlignment="Stretch"
                                    IsEnabled="{Binding RemoveEnabled}"
                                    ToolTip.Tip="Remove file from the list"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>

                    <!-- Input file -->
                    <DataGridTextColumn
                        Header="Input File"
                        Binding="{Binding InputFilePath}"
                        Width="6*" />

                    <!-- Status -->
                    <DataGridTextColumn
                        Header="Status"
                        Binding="{Binding Status}"
                        Width="3*" />

                    <!-- Existing action -->
                    <DataGridTemplateColumn
                        Header="Action"
                        Width="110">

                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button
                                    Content="{Binding ButtonText}"
                                    Command="{Binding ActionCommand}"
                                    Margin="3"
                                    HorizontalAlignment="Stretch" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>


                    <!-- Re-parse -->
                    <DataGridTemplateColumn
                        Header="Re-Parse"
                        Width="110">

                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button
                                    Content="{Binding ReParseText}"
                                    Command="{Binding ReParseCommand}"
                                    Margin="3"
                                    HorizontalAlignment="Stretch" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>


                    <!-- Open traces -->
                    <DataGridTemplateColumn
                        Header="Traces"
                        Width="100">

                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button
                                    Content="Open"
                                    Command="{Binding OpenTracesCommand}"
                                    Margin="3"
                                    HorizontalAlignment="Stretch" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>

                </DataGrid.Columns>

            </DataGrid>

        </Border>

        <!-- Bottom actions -->
        <Grid
            Grid.Row="3"
            ColumnDefinitions="*,Auto">

            <!-- Application actions -->
            <StackPanel
                Orientation="Horizontal"
                Spacing="8">

                <Button
                    Content="Settings"
                    Click="SettingsButton_Click"
                    MinWidth="110"
                    Padding="16,9"
                    IsEnabled="{Binding SettingsEnabled}" />

                <Button
                    Content="Check EI Updates"
                    Click="CheckUpdatesButton_Click"
                    MinWidth="130"
                    Padding="16,9"
                    IsEnabled="{Binding CheckUpdatesEnabled}" />

                <Button 
                    Content="Send all to Discord" 
                    Click="SendAllToDiscordButton_Click" 
                    MinWidth="145" 
                    Padding="16,9" 
                    IsEnabled="{Binding DiscordBatchEnabled}" 
                    ToolTip.Tip="Send currently parsed logs with dps.report links to the Discord webhook in a batch" />

            </StackPanel>

            <!-- Processing actions -->
            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="8">

                <Button
                    Content="Parse All"
                    Click="ParseAllButton_Click"
                    MinWidth="110"
                    Padding="16,9"
                    IsEnabled="{Binding ParseEnabled}" />

                <Button
                    Content="Cancel All"
                    Click="CancelAllButton_Click"
                    MinWidth="110"
                    Padding="16,9"
                    IsEnabled="{Binding CancelAllEnabled}" />

                <Button
                    Content="Clear Failed"
                    Click="ClearFailedButton_Click"
                    MinWidth="110"
                    Padding="16,9"
                    IsEnabled="{Binding ClearFailedEnabled}" />

                <Button
                    Content="Clear All"
                    Click="ClearAllButton_Click"
                    MinWidth="110"
                    Padding="16,9"
                    IsEnabled="{Binding ClearAllEnabled}" />

            </StackPanel>

        </Grid>

        <!-- Footer -->
        <TextBlock
            Grid.Row="4"
            Text="{Binding Version}"
            FontSize="13"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom" />

    </Grid>

</Window>