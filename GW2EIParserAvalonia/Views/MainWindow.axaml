<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:GW2EIParserAvalonia.ViewModels"
    x:Class="GW2EIParserAvalonia.Views.MainWindow"
    x:DataType="viewModels:MainWindowViewModel"
    mc:Ignorable="d"
    Width="1000"
    Height="600"
    MinWidth="800"
    MinHeight="400"
    Title="GW2 Elite Insights"
    DragDrop.AllowDrop="True"
    DragDrop.DragOver="MainWindow_DragOver"
    DragDrop.Drop="MainWindow_Drop">

    <Grid
        RowDefinitions="Auto,Auto,*">

        <StackPanel
            Grid.Row="0"
            Margin="20,20,20,10"
            Spacing="4">

            <TextBlock
                Text="{Binding Title}"
                FontSize="24"
                FontWeight="Bold" />

            <TextBlock
                Text="{Binding Status}"
                Opacity="0.7" />

            <Button
                Content="Check EI Updates"
                Click="CheckUpdatesButton_Click"
                MinWidth="108"
                IsEnabled="{Binding CheckUpdatesEnabled}" />

        </StackPanel>

        <StackPanel
            Grid.Row="1"
            Margin="20,10"
            Orientation="Horizontal"
            Spacing="10">

            <Button
                Content="Add Files..."
                Click="AddFilesButton_Click"
                MinWidth="110" />

            <Button
                Content="Settings..."
                Click="SettingsButton_Click"
                MinWidth="110"
                IsEnabled="{Binding SettingsEnabled}" />

            <Button
                Content="Populate from directory"
                Click="PopulateButton_Click"
                MinWidth="155" />

            <Button
                Content="Parse All"
                Click="ParseAllButton_Click"
                MinWidth="110"
                IsEnabled="{Binding ParseEnabled}" />

            <Button
                Content="Cancel All"
                Click="CancelAllButton_Click"
                MinWidth="100"
                IsEnabled="{Binding CancelAllEnabled}" />

            <Button
                Content="Clear Failed"
                Click="ClearFailedButton_Click"
                MinWidth="100"
                IsEnabled="{Binding ClearFailedEnabled}" />

            <Button
                Content="Clear All"
                Click="ClearAllButton_Click"
                MinWidth="100"
                IsEnabled="{Binding ClearAllEnabled}" />

        </StackPanel>

        <StackPanel
            Grid.Row="2"
            Margin="20,0,20,20"
            Spacing="4">

            <TextBlock
                Text="{Binding WatchingDirectory}"
                IsVisible="{Binding WatchingDirectoryVisible}"
                Opacity="0.7" />

            <DataGrid
                ItemsSource="{Binding LogFiles}"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                CanUserResizeColumns="True"
                GridLinesVisibility="All"
                DoubleTapped="LogFilesGrid_DoubleTapped">

                <DataGrid.Columns>

                    <DataGridTextColumn
                        Header="Input File"
                        Binding="{Binding InputFile}"
                        Width="6*" />

                    <DataGridTextColumn
                        Header="Status"
                        Binding="{Binding Status}"
                        Width="3*" />

                    <DataGridTemplateColumn
                        Header="Action"
                        Width="100">

                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button
                                    Content="{Binding ButtonText}"
                                    Command="{Binding ActionCommand}"
                                    HorizontalAlignment="Stretch" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn
                        Header="Re-Parse"
                        Width="100">

                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button
                                    Content="{Binding ReParseText}"
                                    Command="{Binding ReParseCommand}"
                                    HorizontalAlignment="Stretch" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>

                </DataGrid.Columns>

            </DataGrid>

        </StackPanel>

    </Grid>

</Window>